<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        `android:localeConfig` is read by Android 13+ only, which is what tools:targetApi records —
        it silences lint's "unused below minSdk" note without weakening anything at runtime. Older
        devices ignore the attribute and AppCompat's backport reads the same file instead, so the
        list of shipped languages stays in one place across the whole supported range (ADR-0013).
    -->
    <!--
        Auto Backup runs through BinkyBackupAgent, which names its own file set (ADR-0005) — so
        `backup_rules.xml` and `data_extraction_rules.xml` are gone along with the attributes that
        pointed at them. Static include/exclude XML cannot checkpoint the write-ahead log, and
        without that the platform was eligible to copy the live database and its `-wal` sidecar
        mid-write: a backup that appears to work and restores corrupt.

        `fullBackupOnly` is not optional beside `backupAgent`. Declaring an agent without it puts
        the app on the key/value path, where the agent's no-op onBackup would be what ran.
    -->
    <application
        android:name=".BinkyApplication"
        android:allowBackup="true"
        android:backupAgent=".BinkyBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Binky"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The camera app writes the photo it takes into a file we own, and hands us back a Uri
            for it. A file:// Uri has been illegal to pass across apps since Android 7, so this
            provider vends a content:// one instead, scoped to the single cache directory in
            file_paths.xml. Photo Picker needs none of this — it hands us a Uri of its own — but
            "take a photo" does. No CAMERA permission is declared on purpose: declaring it would
            make it *required* at install time, and firing the system camera intent needs none.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Not a service anybody starts — `android:enabled="false"` means it can never run. It is
            a manifest entry used as a storage slot: AppCompat looks itself up here, reads the
            `autoStoreLocales` flag, and takes responsibility for persisting the chosen language on
            devices below 13, where the platform has no per-app locale store of its own. On 13+ the
            framework persists it and this is ignored.

            ADR-0013 picks this over a fifth DataStore key deliberately: DataStore reads are
            asynchronous (a Flow, so `suspend` before the value exists), and the app would already
            have drawn its first frame in the phone's language before the stored one resolved.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
