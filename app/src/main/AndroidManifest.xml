<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        The app's first user-facing permissions, and the reason docs/play-app-content.md's
        "declares no user-facing permission at all" stops being true at 1.1 (PLAN 4a).

        POST_NOTIFICATIONS is a runtime permission on API 33+ and granted at install below it. It is
        never asked from a bare system dialog on launch — ADR-0006 gives Android only two denials
        before the dialog stops appearing for good, so the ask always follows our own screen
        explaining what it is for.

        RECEIVE_BOOT_COMPLETED is install-time and invisible to the owner. It exists so BootReceiver
        can put the daily sweep back after a restart; the sweep is the only scheduled work in the
        app (ADR-0024), so this permission buys exactly one line of code.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Medication doses, and the one place this app asks for precision (ADR-0003, PLAN 5a).

        SCHEDULE_EXACT_ALARM and **not** USE_EXACT_ALARM. The other one is auto-granted and can never
        be revoked, which sounds like the better deal until you read Play's policy: it is permitted
        only for apps whose core function is an alarm clock or a calendar, and this app's core
        function is a rabbit's weight chart. Declaring it would put the whole listing at risk to save
        one settings screen.

        This one is **denied by default** from Android 14 at targetSdk 33+, so the app assumes
        nothing: it reads `canScheduleExactAlarms()`, says which of the two mechanisms is actually in
        play, and a dose without it still goes in via `setAndAllowWhileIdle` — late but real.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        Package visibility (API 30+) for the one OEM screen the app offers to open: Xiaomi's
        autostart manager, which on HyperOS decides whether background work runs at all (ADR-0003).
        Without this declaration `resolveActivity` returns null on a phone where the activity exists,
        and the app would either hide a button that works or show one that does nothing.

        A named package, not QUERY_ALL_PACKAGES: we look for exactly one thing and say which.
    -->
    <queries>
        <package android:name="com.miui.securitycenter" />
    </queries>

    <!--
        `android:localeConfig` is read by Android 13+ only, which is what tools:targetApi records —
        it silences lint's "unused below minSdk" note without weakening anything at runtime. Older
        devices ignore the attribute and AppCompat's backport reads the same file instead, so the
        list of shipped languages stays in one place across the whole supported range (ADR-0013).
    -->
    <!--
        Auto Backup runs through BinkyBackupAgent, which names its own file set (ADR-0005) — so
        `backup_rules.xml` and `data_extraction_rules.xml` are gone along with the attributes that
        pointed at them. Static include/exclude XML cannot checkpoint the write-ahead log, and
        without that the platform was eligible to copy the live database and its `-wal` sidecar
        mid-write: a backup that appears to work and restores corrupt.

        `fullBackupOnly` is not optional beside `backupAgent`. Declaring an agent without it puts
        the app on the key/value path, where the agent's no-op onBackup would be what ran.
    -->
    <application
        android:name=".BinkyApplication"
        android:allowBackup="true"
        android:backupAgent=".BinkyBackupAgent"
        android:fullBackupOnly="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Binky"
        tools:targetApi="33">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The camera app writes the photo it takes into a file we own, and hands us back a Uri
            for it. A file:// Uri has been illegal to pass across apps since Android 7, so this
            provider vends a content:// one instead, scoped to the single cache directory in
            file_paths.xml. Photo Picker needs none of this — it hands us a Uri of its own — but
            "take a photo" does. No CAMERA permission is declared on purpose: declaring it would
            make it *required* at install time, and firing the system camera intent needs none.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            **WorkManager initialises on demand, not at process start.** Removing its entry from
            androidx.startup's provider is half of that; `BinkyApplication : Configuration.Provider`
            is the other half, and WorkManager then builds itself the first time
            `WorkManager.getInstance` is called.

            The default is an initializer that runs inside a ContentProvider, before
            `Application.onCreate` — and `Application.onCreate` is where ADR-0007's wipe guard lives.
            Initialisation order between "the database may be about to be destroyed" and "background
            work may start touching it" is not something to inherit from whatever the merged
            manifest happens to produce.

            `tools:node="remove"` on the meta-data alone, not on the provider: androidx.startup is
            shared, and other libraries may register initialisers there.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Puts the daily sweep back after a restart, and does nothing else (ADR-0024). It reads no
            persisted schedule because there is none — the due date is derived, and the OS schedule
            was never the source of truth.

            `exported="false"` is correct even though the sender is another process: BOOT_COMPLETED
            is a protected broadcast, which the system is permitted to deliver to a receiver no
            other app can reach.
        -->
        <receiver
            android:name=".work.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            **Three receivers, one function** (ADR-0025, PLAN 5a). BootReceiver above is the first;
            these two are the rest, and all three do nothing but call `rescheduleDoseAlarm()` behind
            ADR-0007's guard. There is one pending dose alarm for the whole app, recomputed from
            truth, so more occasions to rebuild it cost one query each and can never stack.

            No intent-filter on DoseAlarmReceiver on purpose: it is the target of our own
            PendingIntent and nothing else, so it is addressed by component and never by action.
        -->
        <receiver
            android:name=".work.DoseAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!--
            An alarm is an absolute instant; a dose slot is a wall-clock time. Move the clock or fly
            somewhere and the pending alarm points at the wrong moment — TIME_SET covers a manual
            clock change, TIMEZONE_CHANGED the flight. Both are protected broadcasts, which is why
            `exported="false"` is still correct with another process sending them.
        -->
        <receiver
            android:name=".work.TimeChangeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            API 31+. An alarm placed inexactly must be re-placed exactly the moment the owner grants
            the permission — otherwise the first precise dose is whichever one happens to follow the
            next reboot. Only the *grant* arrives here: revoking force-stops the app, so the matching
            rebuild after a revocation is the one at process start.
        -->
        <receiver
            android:name=".work.ExactAlarmPermissionReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            Not a service anybody starts — `android:enabled="false"` means it can never run. It is
            a manifest entry used as a storage slot: AppCompat looks itself up here, reads the
            `autoStoreLocales` flag, and takes responsibility for persisting the chosen language on
            devices below 13, where the platform has no per-app locale store of its own. On 13+ the
            framework persists it and this is ignored.

            ADR-0013 picks this over a fifth DataStore key deliberately: DataStore reads are
            asynchronous (a Flow, so `suspend` before the value exists), and the app would already
            have drawn its first frame in the phone's language before the stored one resolved.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>
    </application>

</manifest>
