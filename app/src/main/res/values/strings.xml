<resources>
    <string name="app_name">Bunny Tracker</string>

    <!-- Bottom-navigation destinations (ADR-0015) -->
    <string name="destination_home">Home</string>
    <string name="destination_weight">Weight</string>
    <string name="destination_observations">Observations</string>
    <string name="destination_care">Care &amp; Meds</string>
    <string name="destination_more">More</string>

    <!-- The bunny switcher -->
    <string name="switcher_open">Choose which bunny to show</string>
    <string name="switcher_all_bunnies">All bunnies</string>
    <string name="switcher_add_bunny">Add a bunny</string>
    <string name="switcher_no_bunnies">No bunnies yet</string>

    <!-- Which bunny a screen is scoped to. Every stub says so, or a stub scoped to the wrong
         bunny would be indistinguishable from one scoped to the right one. -->
    <string name="scope_all_bunnies">Showing all bunnies</string>
    <string name="scope_bunny">Showing %1$s</string>
    <string name="scope_bunny_archived">Showing %1$s, archived</string>

    <!-- The read-only scope onto an archived bunny -->
    <string name="archived_banner">Archived. Records can be read, not changed.</string>
    <string name="archived_banner_leave">Leave</string>

    <string name="action_back">Back</string>
    <string name="action_save">Save</string>
    <string name="action_cancel">Cancel</string>
    <string name="action_edit">Edit</string>
    <string name="action_archive">Archive</string>
    <string name="action_unarchive">Unarchive</string>
    <string name="action_delete">Delete</string>
    <string name="action_ok">OK</string>
    <string name="add_a_bunny_first">Add a bunny first.</string>

    <!-- Home -->
    <string name="home_empty_title">No bunnies yet</string>
    <string name="home_empty_body">Add your first bunny to start keeping records.</string>
    <string name="home_observations_stub">Recent observations arrive in the next checkpoint.</string>
    <string name="home_all_bunnies_stub">Tap a bunny to open it.</string>
    <string name="home_last_weight_label">Last weighing</string>
    <string name="home_last_weight_value">%1$s on %2$s</string>
    <!-- A statement about the record, never about the bunny: silence means nobody looked (ADR-0001). -->
    <string name="home_no_weighings">None recorded yet</string>

    <!-- Weight -->
    <string name="weight_pick_a_bunny">Weight is recorded per bunny. Choose a bunny from the switcher to see its history.</string>
    <string name="weight_add">Record a weighing</string>
    <string name="weight_history_empty">No weighings recorded yet. Three are needed before a trend can be judged at all.</string>
    <string name="weight_delete_title">Delete this weighing?</string>
    <string name="weight_delete_body">%1$s on %2$s is removed from the history, and the trend is worked out again without it.</string>

    <!-- Adding or editing a weighing. Entry is always in grams, whatever the display unit is set
         to, because that is what a scale reads out (house rule). -->
    <string name="weight_entry_add_title">Record a weighing</string>
    <string name="weight_entry_edit_title">Edit a weighing</string>
    <string name="weight_grams_label">Weight in grams</string>
    <string name="weight_grams_help">Whole grams, as the scale reads it.</string>
    <string name="weight_grams_required">Enter the weight in grams.</string>
    <string name="weight_grams_as_kilograms">That is %1$s.</string>
    <string name="weight_recorded_at_label">When the bunny was on the scale</string>
    <string name="weight_pick_date">Change the date</string>
    <string name="weight_pick_time">Change the time</string>
    <string name="weight_backdating_help">Defaults to now. Weigh in the morning and log it in the evening if that suits — the time you set is the one that counts.</string>
    <string name="weight_future_rejected">That is in the future. A weighing that has not happened yet cannot be recorded.</string>

    <!-- The exact-timestamp collision prompt (ADR-0021). Replacing is the default: it is the
         commonest correction, and a second row at the same minute would push a real weighing out
         of the baseline window. -->
    <string name="weight_collision_title">There is already a weighing at that time</string>
    <plurals name="weight_collision_body">
        <item quantity="one">This bunny already has %d weighing recorded at exactly that date and time. Replacing it keeps one reading for that moment; adding a second keeps both.</item>
        <item quantity="other">This bunny already has %d weighings recorded at exactly that date and time. Replacing keeps one reading for that moment; adding another keeps them all.</item>
    </plurals>
    <string name="weight_collision_replace">Replace it</string>
    <string name="weight_collision_add_second">Add a second</string>

    <!-- How a stored weight is rendered. Three decimal places, because storage is whole grams and
         two would hide them. Changes are ALWAYS in grams, whatever the display unit says. -->
    <string name="weight_in_kilograms">%1$s kg</string>
    <string name="weight_in_grams">%1$s g</string>
    <string name="weight_change_down">−%1$s g</string>
    <string name="weight_change_up">+%1$s g</string>
    <string name="weight_change_none">no change</string>

    <!-- The trend flag (ADR-0001). Framed "worth a closer look" and never as a diagnosis; the
         numbers are grams and dated; there is no notification, ever. -->
    <string name="trend_flag_title">Worth a closer look</string>
    <string name="trend_flag_drop">%1$s is down %2$s since %3$s.</string>
    <string name="trend_flag_readings">%1$s then, %2$s now.</string>
    <string name="trend_flag_long_gap">Those two weighings are %1$s apart, so this is a change over a long stretch rather than a sudden one.</string>
    <string name="trend_flag_not_advice">This is an observation about the numbers, not a diagnosis. If you are worried, ask a vet.</string>
    <string name="trend_flag_vet_diet">On a vet-directed diet? Then this is the loss you are aiming for, and you can ignore these.</string>
    <string name="trend_flag_acknowledge">I have seen this</string>
    <string name="trend_flag_acknowledged">Seen %1$s.</string>
    <string name="trend_flag_close">Close</string>

    <!-- How far apart two weighings are. Separate from the age plurals: the same number reads
         differently as a gap than as an age (ADR-0013). -->
    <plurals name="gap_years">
        <item quantity="one">%d year</item>
        <item quantity="other">%d years</item>
    </plurals>
    <plurals name="gap_months">
        <item quantity="one">%d month</item>
        <item quantity="other">%d months</item>
    </plurals>
    <plurals name="gap_weeks">
        <item quantity="one">%d week</item>
        <item quantity="other">%d weeks</item>
    </plurals>

    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_weight_unit">Show weights in</string>
    <string name="settings_unit_kilograms">Kilograms</string>
    <string name="settings_unit_grams">Grams</string>
    <string name="settings_weight_unit_help">This changes how weights are shown, not how they are entered — entry is always in grams, and changes are always shown in grams.</string>
    <string name="settings_preserved_title">Preserved copies</string>
    <string name="settings_preserved_help">When an update cannot read the records already on this phone, a copy is saved here first. Share it somewhere safe — it cannot be loaded back in automatically.</string>
    <string name="settings_preserved_empty">No copies have been saved on this phone.</string>
    <string name="settings_preserved_detail">Saved %1$s · %2$s · %3$s</string>
    <!-- A copy with no sidecars really is one file, so the singular is reachable. -->
    <plurals name="settings_preserved_files">
        <item quantity="one">%d file</item>
        <item quantity="other">%d files</item>
    </plurals>
    <string name="settings_preserved_undated">date unknown</string>
    <string name="settings_preserved_share">Share this copy</string>
    <string name="settings_preserved_delete_title">Delete this copy?</string>
    <string name="settings_preserved_delete_body">%1$s is removed from this phone for good. If you have not shared it somewhere else, it is gone.</string>

    <!-- Debug builds only, and never shown in a release build. -->
    <string name="settings_sample_data">Sample data</string>
    <string name="settings_sample_data_help">Debug builds only. Adds two bunnies and a year of uneven, back-dated weighings, so the chart and the trend flag can be reviewed against real history.</string>
    <string name="settings_sample_data_action">Add the sample data</string>
    <string name="settings_sample_data_seeded">Sample data added.</string>
    <string name="settings_sample_data_present">The sample bunnies are already here.</string>

    <!-- Observations -->
    <string name="observations_stub">The observation timeline arrives in Phase 2.</string>
    <string name="observations_all_stub">The combined timeline across every bunny arrives in Phase 2.</string>
    <string name="log_observation_stub">Logging an observation arrives in Phase 2.</string>

    <!-- Care &amp; Meds -->
    <string name="care_stub">Care reminders arrive in version 1.1, medications in 1.2.</string>

    <!-- More -->
    <string name="more_archived_bunnies">Archived bunnies</string>
    <string name="more_archived_bunnies_summary">Bunnies you have archived. Their records are kept.</string>
    <string name="more_photos">Photos</string>
    <string name="more_documents">Documents</string>
    <string name="more_settings">Settings</string>
    <string name="more_settings_summary">Weight units, and copies kept before an update cleared the records.</string>
    <string name="more_support">Support</string>
    <string name="more_coming_soon">Coming soon</string>

    <!-- The archived list (ADR-0004): reachable, with unarchive, delete, and a read-only scope -->
    <string name="archived_title">Archived bunnies</string>
    <string name="archived_empty">Nothing archived. Archiving hides a bunny from the switcher and keeps every record.</string>
    <string name="archived_on">Archived %1$s</string>
    <string name="archived_open">Open</string>

    <!-- Bunny profile -->
    <string name="bunny_editor_add_title">Add a bunny</string>
    <string name="bunny_editor_edit_title">Edit bunny</string>
    <string name="bunny_name_label">Name</string>
    <string name="bunny_name_required">A bunny needs a name.</string>
    <string name="bunny_avatar_take">Take a photo</string>
    <string name="bunny_avatar_choose">Choose a photo</string>
    <string name="bunny_avatar_remove">Remove the photo</string>
    <string name="bunny_avatar_failed">That picture could not be read. Try another one.</string>
    <string name="bunny_avatar_description">Photo of %1$s</string>
    <string name="bunny_avatar_placeholder">No photo yet</string>
    <string name="bunny_birthdate_label">Birthday</string>
    <string name="bunny_birthdate_none">Not known</string>
    <string name="bunny_birthdate_set">Set a birthday</string>
    <string name="bunny_birthdate_clear">Clear the birthday</string>
    <string name="bunny_birthdate_approximate">Approximate</string>
    <string name="bunny_birthdate_approximate_help">Rescues often arrive with a guessed age. An approximate birthday is shown as an age, never as a date.</string>
    <string name="bunny_sex_label">Sex</string>
    <string name="sex_male">Male</string>
    <string name="sex_female">Female</string>
    <string name="sex_unknown">Unknown</string>
    <string name="bunny_neutered_label">Neutered</string>
    <string name="neutered_yes">Yes</string>
    <string name="neutered_no">No</string>
    <string name="neutered_unknown">Unknown</string>
    <string name="bunny_breed_label">Breed</string>
    <string name="bunny_colour_label">Colour and markings</string>
    <string name="bunny_lives_with_label">Lives with</string>
    <string name="bunny_lives_with_alone">Lives alone</string>
    <string name="bunny_lives_with_nobody_yet">Add a second bunny to record who they live with.</string>
    <string name="bunny_lives_with_help">Bonded bunnies share a litter tray, so one observation can cover all of them.</string>
    <string name="bunny_lives_with_value">Lives with %1$s</string>
    <string name="bunny_archived_name">%1$s (archived)</string>

    <!-- ADR-0007's consent half. The copy has already been taken by the time this shows, and no
         migration exists to read the old file back, so the screen states what is going and where
         the copy is rather than pretending there is a choice. One forward button, no cancel. -->
    <string name="wipe_title">This update has to clear the records on this phone</string>
    <string name="wipe_body">Bunny Tracker is still being built, and this version changed how records are stored. It cannot read what is already on this phone, so that has to go.</string>
    <string name="wipe_versions">Records on this phone: format %1$d. This version: format %2$d.</string>
    <string name="wipe_copy_taken">A copy has already been saved on this phone before anything is deleted:</string>
    <string name="wipe_copy_reach">The copy cannot be loaded back in automatically — reading old records into the new format is a conversion that has to be written by hand. Keep any weights you care about written down somewhere else until backup arrives.</string>
    <string name="wipe_continue">Clear the records and continue</string>

    <!-- Joining names into a list. Never concatenated with " &amp; ": other languages join lists
         differently, and this label appears in the switcher, on the profile and in Phase 2's
         healthy-day snackbar (ADR-0008, ADR-0013). -->
    <string name="list_join_pair">%1$s &amp; %2$s</string>
    <string name="list_join_more">%1$s, %2$s</string>

    <!-- Age. An approximate birthday wraps the same age rather than being spelled out twice, so a
         translator adjusts one string (ADR-0016). -->
    <string name="age_approximate">~%1$s</string>
    <plurals name="age_years">
        <item quantity="one">%d year old</item>
        <item quantity="other">%d years old</item>
    </plurals>
    <plurals name="age_months">
        <item quantity="one">%d month old</item>
        <item quantity="other">%d months old</item>
    </plurals>
    <plurals name="age_weeks">
        <item quantity="one">%d week old</item>
        <item quantity="other">%d weeks old</item>
    </plurals>

    <!-- Archiving asks once and says plainly that nothing is lost (ADR-0004) -->
    <string name="archive_dialog_title">Archive %1$s?</string>
    <string name="archive_dialog_body">Every record is kept and stays readable under More. %1$s leaves the bunny switcher, and you can bring them back at any time.</string>

    <!-- Deleting is the explicit escape hatch. A second dialog appears only when there is history
         to destroy — an avatar is not history (ADR-0004). -->
    <string name="delete_dialog_title">Delete %1$s?</string>
    <string name="delete_dialog_body">This removes the bunny from the app. Archiving instead keeps everything and only hides them.</string>
    <string name="delete_dialog_avatar_note">Their photo is deleted from this phone too.</string>
    <string name="delete_dialog_second_title">Delete %1$s and their records?</string>
    <string name="delete_dialog_second_body">This cannot be undone.</string>
    <plurals name="delete_records_sole_owned">
        <item quantity="one">%d record kept only for this bunny is destroyed.</item>
        <item quantity="other">%d records kept only for this bunny are destroyed.</item>
    </plurals>
    <plurals name="delete_records_shared">
        <item quantity="one">%d shared entry stays, for the other bunnies it covered.</item>
        <item quantity="other">%d shared entries stay, for the other bunnies they covered.</item>
    </plurals>
</resources>
