    <string name="setup_step">Step %1$d of %2$d</string>
    <string name="setup_continue">Continue</string>
    <string name="setup_back">Back a step</string>
    <string name="setup_bunny_title">Welcome to Binky</string>
    <string name="setup_bunny_body">Binky keeps your bunnies\' health history on this phone — weights, observations, vet visits, photos and reminders. There is no account and no server: nothing you record here is sent anywhere.\n\nTwo quick questions, and then it is yours.</string>
    <string name="setup_bunny_action">Add your first bunny</string>
    <string name="setup_bunny_add_another">Add another bunny</string>
    <string name="setup_bunny_skip">Skip for now</string>
    <string name="setup_bunny_added_one">%1$s is in. You can add more bunnies at any time from the switcher at the top of the screen.</string>
    <string name="setup_bunny_added_many">Your bunnies are in. You can add more at any time from the switcher at the top of the screen.</string>
    <string name="setup_backup_title">Keeping your records safe</string>
    <string name="setup_backup_body">Everything lives on this phone, which means a lost phone is a lost history unless something is copying it. Two different things can, and neither one covers everything.</string>
    <string name="setup_backup_auto_ask">Binky cannot tell whether it is switched on, and cannot switch it on for you. Now is a good moment to check.</string>
    <string name="setup_backup_scope_help">This is what an export you make yourself will contain. It is also the default you can change later.</string>
    <string name="setup_backup_changeable">All of this stays editable in Settings › Backup &amp; restore.</string>
    <string name="setup_finish">Finish setup</string>

    <!-- Debug builds only, and never shown in a release build. -->
    <string name="settings_sample_data">Sample data</string>
    <string name="settings_sample_data_help">Debug builds only. Adds two bonded bunnies, a year of uneven, back-dated weighings and a handful of observations, so the chart, the trend flag and the timeline can be reviewed against real history.</string>
    <string name="settings_sample_data_action">Add the sample data</string>
    <string name="settings_sample_data_seeded">Sample data added.</string>
    <string name="settings_sample_data_present">The sample bunnies are already here.</string>

    <!-- Backup and restore (ADR-0005). The photo-gallery warning is not decoration: photos are the
         least protected data in the app, and ADR-0001's rule about silence says a gap the owner
         cannot see is worse than one they were told about. -->
    <string name="backup_title">Backup &amp; restore</string>

    <!-- The automatic net, stated in all three states (ADR-0005). Absence is spelled out rather than
         left blank: Binky cannot ask Android whether it is actually being backed up, and an empty
         line would read as a working net. Past a fortnight a bare date is a claim, not a comfort. -->
    <string name="backup_auto_title">Automatic backup</string>
    <string name="backup_auto_help">Android backs Binky up to your Google account on its own schedule — when the phone is idle, charging and online. Binky cannot switch that on or check it for you.</string>
    <string name="backup_auto_never">No automatic backup has been recorded on this phone.</string>
    <string name="backup_auto_recorded">Last automatic backup: %1$s.</string>
    <string name="backup_auto_stale">The last automatic backup was on %1$s — more than two weeks ago. Something may have turned it off.</string>
    <string name="backup_auto_photos">It covers your records, your settings and your bunny avatars. Your photo gallery is not in it.</string>
    <string name="backup_auto_settings_action">Open Android backup settings</string>

    <string name="backup_scope_title">What an export includes</string>
    <string name="backup_scope_essential">Essential</string>
    <string name="backup_scope_records">Records</string>
    <string name="backup_scope_everything">Everything</string>
    <string name="backup_scope_essential_help">Your records, your settings, and bunny avatars. The smallest useful backup.</string>
    <string name="backup_scope_records_help">Everything in Essential, plus scanned documents — everything you might need again.</string>
    <string name="backup_scope_everything_help">Everything in Records, plus your photo gallery. Much larger, and the only backup your photos ever get.</string>
    <string name="backup_photos_warning">Your photos are the least protected thing in Binky. Android\'s automatic backup leaves the gallery out, and so do Essential and Records. An “Everything” export is the only copy your photos will ever have.</string>
    <string name="backup_export_action">Export a backup</string>
    <string name="backup_exporting">Building the backup…</string>
    <string name="backup_export_share">Share this backup</string>

    <string name="backup_restore_title">Restore</string>
    <string name="backup_restore_help">Restoring replaces everything Binky currently holds with what is inside the file. A copy of the current records is saved to this phone first, so a restore can be undone.</string>
    <string name="backup_restore_action">Restore from a file</string>
    <string name="backup_restore_confirm_title">Restore this backup?</string>
    <!-- Scope and date both come from the manifest inside the zip, never from the filename. -->
    <string name="backup_restore_confirm_body">%1$s backup from %2$s.\n\nEverything Binky currently holds is replaced. A copy of the current records is saved to this phone first.</string>
    <string name="backup_restore_confirm_action">Replace everything</string>
    <string name="backup_restoring">Restoring…</string>

    <string name="backup_refused_title">Nothing was restored</string>
    <string name="backup_refused_not_a_backup">This file is not a Binky backup. Nothing on this phone was changed.</string>
    <string name="backup_refused_newer">This backup was made by a newer version of Binky, which this one cannot read. It was saved at version %1$d, and this app reads up to version %2$d. Nothing on this phone was changed.</string>
    <string name="backup_refused_too_large">This file is far too large to be a Binky backup. Nothing on this phone was changed.</string>
    <string name="backup_refused_unreadable">Binky could not open the records inside this backup, so nothing was changed. The file may be damaged.</string>

    <string name="backup_restored_title">Restore finished</string>
    <!-- "the", not "a": two of the three scope names start with a vowel, and an article chosen at
         build time cannot agree with a name chosen at run time. -->
    <string name="backup_restored_scope">Restored the %1$s backup from %2$s.</string>
    <plurals name="backup_restored_overlaid">
        <item quantity="one">%d image came from the backup.</item>
        <item quantity="other">%d images came from the backup.</item>
    </plurals>
    <plurals name="backup_restored_kept">
        <item quantity="one">%d image already on this phone was outside this backup\'s scope and was kept.</item>
        <item quantity="other">%d images already on this phone were outside this backup\'s scope and were kept.</item>
    </plurals>
    <string name="backup_restored_snapshot">What Binky held before this restore was saved as %1$s, under “Copies kept on this phone”.</string>
    <string name="backup_restored_close">Close Binky</string>
    <string name="backup_restored_close_help">Binky has to close so it reopens on the restored records. Start it again from your home screen.</string>

    <!-- The two occupants of preserved/: shared by the Backup screen and by ADR-0023's
         schema-mismatch screen, which is why these are neither settings_ nor backup_. -->
    <string name="preserved_title">Copies kept on this phone</string>
    <string name="preserved_help">Binky saves a copy before anything that would replace your records. Nothing here is ever deleted automatically.</string>
    <string name="preserved_empty">No copies have been saved on this phone.</string>
    <string name="preserved_detail">Saved %1$s · %2$s · %3$s</string>
