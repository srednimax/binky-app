    <!-- Home -->
    <string name="home_empty_title">No bunnies yet</string>
    <string name="home_empty_body">Add your first bunny to start keeping records.</string>
    <string name="home_all_bunnies_stub">Tap a bunny to open it.</string>
    <string name="home_last_weight_label">Last weighing</string>
    <string name="home_last_weight_value">%1$s on %2$s</string>
    <string name="home_last_observation_label">Last observation</string>
    <!-- Two statements about the record, never about the bunny: silence means nobody looked,
         not that all was well (ADR-0001). -->
    <string name="home_no_weighings">None recorded yet</string>
    <string name="home_no_observations">None recorded yet</string>

    <!-- Weight -->
    <string name="weight_pick_a_bunny">Weight is recorded per bunny. Choose a bunny from the switcher to see its history.</string>
    <string name="weight_add">Record a weighing</string>
    <string name="weight_history_empty">No weighings recorded yet. Three are needed before a trend can be judged at all.</string>
    <string name="weight_delete_title">Delete this weighing?</string>
    <string name="weight_delete_body">%1$s on %2$s is removed from the history, and the trend is worked out again without it.</string>

    <!-- The chart's range selector (ADR-0022). Display-only: it changes what is drawn and never
         what the trend flag reads, so the flag can legitimately sit above an empty chart. -->
    <string name="weight_chart_range_30d">30 days</string>
    <string name="weight_chart_range_90d">90 days</string>
    <string name="weight_chart_range_1y">1 year</string>
    <string name="weight_chart_range_all">All</string>

    <!-- The same windows as they read inside a sentence. "All" is spelled out for completeness but
         is unreachable in this copy: with no cutoff, every weighing is inside the window. -->
    <string name="weight_chart_window_30d">the last 30 days</string>
    <string name="weight_chart_window_90d">the last 90 days</string>
    <string name="weight_chart_window_1y">the last year</string>
    <string name="weight_chart_window_all">all time</string>

    <!-- Three empty states, not two. The third names the date of the last weighing: saying "nothing
         recorded yet" when the app is holding a year of readings would be ADR-0001's silence
         failure in miniature. Widening is offered, never done on the owner's behalf. -->
    <string name="weight_chart_no_weighings">Nothing to plot yet. A chart needs at least two weighings.</string>
    <string name="weight_chart_single_point">One weighing so far. A second gives the chart a line to draw.</string>
    <string name="weight_chart_single_in_range">Only one weighing in %1$s, so there is no line to draw. There are earlier ones.</string>
    <string name="weight_chart_none_in_range">No weighings in %1$s. The most recent one was on %2$s.</string>
    <string name="weight_chart_show_all">Show all weighings</string>

    <!-- Adding or editing a weighing. Entry is always in grams, whatever the display unit is set
         to, because that is what a scale reads out (house rule). -->
    <string name="weight_entry_add_title">Record a weighing</string>
    <string name="weight_entry_edit_title">Edit a weighing</string>
    <string name="weight_grams_label">Weight in grams</string>
    <string name="weight_grams_help">Whole grams, as the scale reads it.</string>
    <string name="weight_grams_required">Enter the weight in grams.</string>
    <string name="weight_grams_as_kilograms">That is %1$s.</string>
    <string name="weight_recorded_at_label">When the bunny was on the scale</string>
    <string name="weight_backdating_help">Defaults to now. Weigh in the morning and log it in the evening if that suits — the time you set is the one that counts.</string>
    <string name="weight_future_rejected">That is in the future. A weighing that has not happened yet cannot be recorded.</string>

    <!-- The exact-timestamp collision prompt (ADR-0021). Replacing is the default: it is the
         commonest correction, and a second row at the same minute would push a real weighing out
         of the baseline window. -->
    <string name="weight_collision_title">There is already a weighing at that time</string>
    <plurals name="weight_collision_body">
        <item quantity="one">This bunny already has %d weighing recorded at exactly that date and time. Replacing it keeps one reading for that moment; adding a second keeps both.</item>
        <item quantity="other">This bunny already has %d weighings recorded at exactly that date and time. Replacing keeps one reading for that moment; adding another keeps them all.</item>
    </plurals>
    <string name="weight_collision_replace">Replace it</string>
    <string name="weight_collision_add_second">Add a second</string>

    <!-- How a stored weight is rendered. Three decimal places, because storage is whole grams and
         two would hide them. Changes are ALWAYS in grams, whatever the display unit says. -->
    <string name="weight_in_kilograms">%1$s kg</string>
    <string name="weight_in_grams">%1$s g</string>
    <string name="weight_change_down">−%1$s g</string>
    <string name="weight_change_up">+%1$s g</string>
    <string name="weight_change_none">no change</string>

    <!-- The trend flag (ADR-0001). Framed "worth a closer look" and never as a diagnosis; the
         numbers are grams and dated; there is no notification, ever. -->
    <string name="trend_flag_title">Worth a closer look</string>
    <string name="trend_flag_drop">%1$s is down %2$s since %3$s.</string>
    <string name="trend_flag_readings">%1$s then, %2$s now.</string>
    <string name="trend_flag_long_gap">Those two weighings are %1$s apart, so this is a change over a long stretch rather than a sudden one.</string>
    <string name="trend_flag_not_advice">This is an observation about the numbers, not a diagnosis. If you are worried, ask a vet.</string>
    <string name="trend_flag_vet_diet">On a vet-directed diet? Then this is the loss you are aiming for, and you can ignore these.</string>
    <string name="trend_flag_acknowledge">I have seen this</string>
    <string name="trend_flag_acknowledged">Seen %1$s.</string>
    <string name="trend_flag_close">Close</string>

    <!-- How far apart two weighings are. Separate from the age plurals: the same number reads
         differently as a gap than as an age (ADR-0013). -->
    <plurals name="gap_years">
        <item quantity="one">%d year</item>
        <item quantity="other">%d years</item>
    </plurals>
    <plurals name="gap_months">
        <item quantity="one">%d month</item>
        <item quantity="other">%d months</item>
    </plurals>
    <plurals name="gap_weeks">
        <item quantity="one">%d week</item>
