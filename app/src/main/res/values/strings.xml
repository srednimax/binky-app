    <!-- ADR-0007's consent half. The copy has already been taken by the time this shows, and no
         migration exists to read the old file back, so the screen states what is going and where
         the copy is rather than pretending there is a choice. One forward button, no cancel. -->
    <string name="wipe_title">This update has to clear the records on this phone</string>
    <string name="wipe_body">Bunny Tracker is still being built, and this version changed how records are stored. It cannot read what is already on this phone, so that has to go.</string>
    <string name="wipe_versions">Records on this phone: format %1$d. This version: format %2$d.</string>
    <string name="wipe_copy_taken">A copy has already been saved on this phone before anything is deleted:</string>
    <string name="wipe_copy_reach">The copy cannot be loaded back in automatically — reading old records into the new format is a conversion that has to be written by hand. Keep any weights you care about written down somewhere else until backup arrives.</string>
    <string name="wipe_continue">Clear the records and continue</string>

    <!-- Joining names into a list. Never concatenated with " &amp; ": other languages join lists
         differently, and this label appears in the switcher, on the profile and in Phase 2's
         healthy-day snackbar (ADR-0008, ADR-0013). -->
    <string name="list_join_pair">%1$s &amp; %2$s</string>
    <string name="list_join_more">%1$s, %2$s</string>

    <!-- Age. An approximate birthday wraps the same age rather than being spelled out twice, so a
         translator adjusts one string (ADR-0016). -->
    <string name="age_approximate">~%1$s</string>
    <plurals name="age_years">
        <item quantity="one">%d year old</item>
        <item quantity="other">%d years old</item>
    </plurals>
    <plurals name="age_months">
        <item quantity="one">%d month old</item>
        <item quantity="other">%d months old</item>
    </plurals>
    <plurals name="age_weeks">
        <item quantity="one">%d week old</item>
        <item quantity="other">%d weeks old</item>
    </plurals>

    <!-- Archiving asks once and says plainly that nothing is lost (ADR-0004) -->
    <string name="archive_dialog_title">Archive %1$s?</string>
    <string name="archive_dialog_body">Every record is kept and stays readable under More. %1$s leaves the bunny switcher, and you can bring them back at any time.</string>

    <!-- Deleting is the explicit escape hatch. A second dialog appears only when there is history
         to destroy — an avatar is not history (ADR-0004). -->
    <string name="delete_dialog_title">Delete %1$s?</string>
    <string name="delete_dialog_body">This removes the bunny from the app. Archiving instead keeps everything and only hides them.</string>
    <string name="delete_dialog_avatar_note">Their photo is deleted from this phone too.</string>
    <string name="delete_dialog_second_title">Delete %1$s and their records?</string>
    <string name="delete_dialog_second_body">This cannot be undone.</string>
    <plurals name="delete_records_sole_owned">
        <item quantity="one">%d record kept only for this bunny is destroyed.</item>
        <item quantity="other">%d records kept only for this bunny are destroyed.</item>
    </plurals>
    <plurals name="delete_records_shared">
        <item quantity="one">%d shared entry stays, for the other bunnies it covered.</item>
        <item quantity="other">%d shared entries stay, for the other bunnies they covered.</item>
    </plurals>
